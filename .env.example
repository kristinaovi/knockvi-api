# MySQL connection
DB_HOST=	    # e.g. localhost
DB_USER=    	    # e.g. root
DB_PASS=    	    # e.g. supersecret
DB_NAME=	 	    # e.g. manufacturingdb

# JWT secret (used to sign/verify tokens)
JWT_SECRET=  # pick a long random string

# (Optional) Port your server listens on
PORT=3000                   # defaults to 3000 if unset

